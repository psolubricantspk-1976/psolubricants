# Copy to .env.local for local preview. Add the same values in Vercel Environment Variables.
# These are public browser settings. NEVER use a service_role or sb_secret_ key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Recommended for public launch: Cloudflare Turnstile, also enabled in Supabase Auth.
# Its SECRET key belongs only in Supabase's CAPTCHA settings, not here.
VITE_TURNSTILE_SITE_KEY=
